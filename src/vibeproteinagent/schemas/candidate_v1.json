{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/candidate_v1.json",
  "title": "VPA Candidate v1",
  "type": "object",
  "required": ["schema_version", "candidate_id", "source"],
  "properties": {
    "schema_version": {
      "const": "candidate_v1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": ["tool", "local_id"],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "job_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "local_id": {
          "type": "string",
          "minLength": 1
        },
        "native_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "sequence": {
      "type": "string",
      "minLength": 1
    },
    "structure_path": {
      "type": "string",
      "minLength": 1
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      },
      "default": {}
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      },
      "default": {}
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "has_sequence": {"type": "boolean"},
        "has_backbone_structure": {"type": "boolean"},
        "has_full_structure": {"type": "boolean"},
        "has_candidate_scores": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
