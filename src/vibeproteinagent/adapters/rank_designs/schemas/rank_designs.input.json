{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/rank_designs.input.json",
  "type": "object",
  "properties": {
    "predictions": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "analyses": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "qc_results": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "candidates": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "top_k": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 10},
    "output_prefix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$",
      "default": "rank_designs"
    }
  },
  "additionalProperties": false
}
