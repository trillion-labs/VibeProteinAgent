{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/rank_designs.output.json",
  "type": "object",
  "required": [
    "candidate_count",
    "ranked_candidates",
    "ranked_json",
    "ranked_tsv",
    "runtime_ms"
  ],
  "properties": {
    "candidate_count": {"type": "integer", "minimum": 1},
    "ranked_candidates": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "ranked_json": {"type": "string", "minLength": 1},
    "ranked_tsv": {"type": "string", "minLength": 1},
    "warnings": {
      "type": "array",
      "items": {"type": "string"},
      "default": [],
      "description": "Runtime warnings about unmatched evidence rows when ranking outputs from job_ids."
    },
    "runtime_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
