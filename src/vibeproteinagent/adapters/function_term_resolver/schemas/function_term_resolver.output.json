{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/function_term_resolver.output.json",
  "type": "object",
  "required": ["query", "status", "matches", "warnings", "targets", "ready_for_execution", "ambiguous", "runtime_ms"],
  "properties": {
    "query": {"type": "string"},
    "status": {"type": "string", "enum": ["resolved", "no_match", "ambiguous", "backend_error", "parse_error"]},
    "matches": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "targets": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "ready_for_execution": {"type": "boolean"},
    "ambiguous": {"type": "boolean"},
    "selected_go_id": {"type": ["string", "null"]},
    "selected_interpro_id": {"type": ["string", "null"]},
    "selection_reason": {"type": ["string", "null"]},
    "runtime_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
