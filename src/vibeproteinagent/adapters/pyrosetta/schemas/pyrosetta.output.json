{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/pyrosetta.output.json",
  "type": "object",
  "required": ["mode", "total_score", "runtime_ms"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["score", "interface", "relax", "pack"],
      "description": "Echoes the input mode."
    },
    "total_score": {
      "type": "number",
      "description": "REF2015 total score of the (relaxed/packed if applicable) pose, in REU."
    },
    "interface_metrics": {
      "type": ["object", "null"],
      "description": "InterfaceAnalyzerMover output when mode=interface, else null.",
      "properties": {
        "dG_separated": {"type": ["number", "null"]},
        "dG_separated_per_int_area": {"type": ["number", "null"]},
        "dSASA": {"type": ["number", "null"]},
        "sc": {"type": ["number", "null"]},
        "packstat": {"type": ["number", "null"]},
        "nres_int": {"type": ["integer", "null"]},
        "interface_hbonds": {"type": ["integer", "null"]}
      },
      "additionalProperties": true
    },
    "relaxed_pdb_path": {
      "type": ["string", "null"],
      "description": "Path to the relaxed/packed PDB written under <job_dir>/outputs/, or null."
    },
    "candidates": {
      "$comment": "Canonical Candidate v1 items; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "runtime_ms": {
      "type": "integer",
      "minimum": 0
    },
    "seed_used": {
      "type": ["integer", "null"]
    }
  },
  "additionalProperties": false
}
