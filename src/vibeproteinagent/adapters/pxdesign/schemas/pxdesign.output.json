{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/pxdesign.output.json",
  "type": "object",
  "required": ["designs", "runtime_ms", "num_samples"],
  "properties": {
    "designs": {
      "type": "array",
      "description": "Generated binder designs. The structure artifact should be treated as target context plus designed binder backbone coordinates; full-atom binder sidechain coordinates are not guaranteed.",
      "items": {
        "type": "object",
        "required": [
          "pdb_path",
          "cif_path",
          "score",
          "sequence",
          "binder_length"
        ],
        "properties": {
          "candidate_id": {"type": ["string", "null"], "minLength": 1},
          "pdb_path": {
            "type": ["string", "null"],
            "description": "Optional PDB artifact when available. Treat as backbone-level binder geometry unless a downstream refinement tool emits full sidechains."
          },
          "cif_path": {
            "type": "string",
            "description": "Primary PXDesign structure artifact containing target context and designed binder backbone coordinates."
          },
          "score": {"type": ["number", "null"]},
          "sequence": {
            "type": "string",
            "description": "Designed binder amino-acid sequence assigned after the ProteinMPNN stage."
          },
          "binder_length": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": true
      }
    },
    "candidates": {
      "$comment": "Canonical Candidate v1 items; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "runtime_ms": {"type": "integer", "minimum": 0},
    "num_samples": {"type": "integer", "minimum": 1},
    "task_name": {"type": ["string", "null"]},
    "seed": {"type": ["integer", "null"]}
  },
  "additionalProperties": false
}
