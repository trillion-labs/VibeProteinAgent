{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/tool-descriptor.json",
  "title": "ToolDescriptor",
  "type": "object",
  "required": [
    "name",
    "version",
    "category",
    "description",
    "runtime",
    "backend",
    "gpu_required",
    "startup_cost",
    "estimated_runtime_s",
    "warm_load_capable",
    "supported_tasks",
    "input_schema",
    "output_schema",
    "supported_precisions"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+-]+$"
    },
    "category": {
      "type": "string",
      "enum": [
        "structure_prediction",
        "protein_design",
        "sequence_engineering",
        "retrieval",
        "analysis",
        "inverse_folding",
        "embedding",
        "scoring",
        "docking",
        "md",
        "misc"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "runtime": {
      "type": "string",
      "enum": ["python", "docker"]
    },
    "backend": {
      "type": "string",
      "enum": ["pytorch", "jax", "biopython", "numpy", "binary", "mixed"]
    },
    "gpu_required": {"type": "boolean"},
    "gpus_required": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 1
    },
    "vram_min_gib": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "startup_cost": {
      "type": "string",
      "enum": ["low", "med", "high"]
    },
    "estimated_runtime_s": {
      "type": "integer",
      "minimum": 0,
      "description": "Rough p50 wall-clock runtime estimate for one representative invocation on a local high-end GPU/CPU host."
    },
    "warm_load_capable": {
      "type": "boolean",
      "description": "True only when warm/preload keeps meaningful runtime state resident across calls, not merely when the adapter object can be constructed."
    },
    "pin_warm": {
      "type": "boolean",
      "default": false
    },
    "execution_isolation": {
      "type": "string",
      "enum": ["shared_env", "persistent_sidecar", "subprocess", "docker"],
      "default": "shared_env",
      "description": "How the adapter executes relative to the shared vpa Python environment."
    },
    "environment_name": {
      "type": ["string", "null"],
      "description": "Named compatibility environment when execution_isolation is not shared_env."
    },
    "environment_reason": {
      "type": ["string", "null"],
      "maxLength": 400,
      "description": "Short reason the adapter cannot safely live inside the shared vpa env."
    },
    "support_status": {
      "type": "string",
      "enum": [
        "verified",
        "partial",
        "blocked_dep",
        "blocked_license",
        "blocked_unavailable"
      ],
      "default": "verified",
      "description": "Current validation/support tier for this adapter or advertised mode set."
    },
    "support_status_reason": {
      "type": ["string", "null"],
      "maxLength": 500,
      "description": "Short machine-readable note explaining non-verified or mixed support status."
    },
    "availability_probe": {
      "type": ["string", "null"],
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[a-zA-Z_][A-Za-z0-9_]*$",
      "description": "Import path to a zero-argument probe returning an actionable skip reason or null."
    },
    "distributed_entrypoint": {
      "type": ["string", "null"],
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Optional adapter-level distributed runner. Required before gpus_required > 1 jobs may be admitted to multi-worker dispatch."
    },
    "supported_tasks": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "input_schema": {
      "oneOf": [
        {"type": "object"},
        {"type": "string", "pattern": "^[a-zA-Z0-9_./-]+\\.json$"}
      ]
    },
    "output_schema": {
      "oneOf": [
        {"type": "object"},
        {"type": "string", "pattern": "^[a-zA-Z0-9_./-]+\\.json$"}
      ]
    },
    "supported_precisions": {
      "type": "array",
      "items": {"type": "string", "enum": ["fp32", "tf32", "bf16", "fp16", "fp8"]},
      "minItems": 1
    },
    "weight_uris": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uri", "sha256"],
        "properties": {
          "uri": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "supports_batching": {
      "type": "boolean",
      "default": false
    },
    "incompatible_with": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "uniqueItems": true,
      "description": "Tool names that must not be co-resident in the same worker process."
    },
    "fusion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_kind": {
          "type": "string",
          "enum": ["torch.Tensor (cuda)", "torch.Tensor (cpu)", "disk"]
        },
        "input_kinds": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "sharding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "shardable_fields", "recommended_shard_size"],
      "properties": {
        "strategy": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Planner-facing candidate/job sharding strategy."
        },
        "shardable_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Input fields a planner may vary across foreach shards."
        },
        "recommended_shard_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Recommended count per shard for expensive fan-out jobs."
        },
        "default_max_parallel": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Default foreach max_parallel when the user has not set a GPU budget."
        }
      }
    },
    "entry_point": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
    }
  },
  "additionalProperties": false
}
