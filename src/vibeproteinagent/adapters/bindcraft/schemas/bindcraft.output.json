{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/bindcraft.output.json",
  "type": "object",
  "required": [
    "designs",
    "runtime_ms",
    "num_designs_returned",
    "seeds_used"
  ],
  "properties": {
    "designs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pdb_path", "sequence", "binder_length"],
        "properties": {
          "pdb_path": {
            "type": "string",
            "minLength": 1,
            "description": "Path to the accepted binder PDB (BindCraft writes these under ``<design_path>/Accepted/``)."
          },
          "sequence": {
            "type": "string",
            "minLength": 1,
            "description": "MPNN-designed sequence selected by BindCraft for this binder."
          },
          "binder_length": {"type": "integer", "minimum": 1},
          "iptm": {
            "type": ["number", "null"],
            "description": "AF2 interface predicted TM score on the validation pass."
          },
          "plddt": {
            "type": ["number", "null"],
            "description": "AF2 pLDDT for the binder chain on the validation pass."
          },
          "pae_interaction": {
            "type": ["number", "null"],
            "description": "Interaction PAE (binder ↔ target) on the validation pass."
          },
          "sap_score": {
            "type": ["number", "null"],
            "description": "PyRosetta SAP (surface aggregation propensity) of the binder."
          }
        },
        "additionalProperties": false
      }
    },
    "runtime_ms": {"type": "integer", "minimum": 0},
    "num_designs_returned": {"type": "integer", "minimum": 0},
    "seeds_used": {
      "type": "array",
      "items": {"type": "integer"}
    }
  },
  "additionalProperties": false
}
