{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/proteina_complexa.input.json",
  "type": "object",
  "required": ["mode"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["protein_binder", "ligand_binder", "motif"],
      "description": "Proteina-Complexa task: protein_binder designs binders to a protein target; ligand_binder designs binders around a ligand pocket; motif scaffolds a functional motif."
    },
    "target_pdb": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Protein target PDB for protein_binder, or ligand-only PDB for ligand_binder.",
      "vpa:digest": "sha256-if-path"
    },
    "target_chain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1,
      "default": "A"
    },
    "target_pocket_residues": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "default": [],
      "description": "ligand_binder only: FASTA/sequence 1-indexed target positions when target_sequence/target_fasta_path is provided; otherwise legacy structure residue numbers."
    },
    "target_pocket_residue_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": [],
      "description": "ligand_binder only: explicit structure residue IDs such as A10 or B82A."
    },
    "target_sequence": {
      "type": ["string", "null"],
      "default": null
    },
    "target_fasta_path": {
      "type": ["string", "null"],
      "minLength": 1,
      "default": null,
      "vpa:digest": "sha256-if-path"
    },
    "ligand_smiles": {
      "type": ["string", "null"],
      "minLength": 1,
      "default": null,
      "description": "ligand_binder only: ligand SMILES."
    },
    "motif_pdb": {
      "type": ["string", "null"],
      "minLength": 1,
      "default": null,
      "description": "motif only: PDB containing the motif residues to preserve.",
      "vpa:digest": "sha256-if-path"
    },
    "motif_chain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1,
      "default": "A"
    },
    "motif_residues": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "default": [],
      "description": "motif only: FASTA/sequence 1-indexed positions to preserve when motif_sequence/motif_fasta_path is provided; otherwise legacy structure residue numbers."
    },
    "motif_residue_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": [],
      "description": "motif only: explicit structure residue IDs such as A10 or B82A."
    },
    "motif_sequence": {
      "type": ["string", "null"],
      "default": null
    },
    "motif_fasta_path": {
      "type": ["string", "null"],
      "minLength": 1,
      "default": null,
      "vpa:digest": "sha256-if-path"
    },
    "position_basis": {
      "type": "string",
      "enum": ["auto", "sequence", "structure"],
      "default": "auto"
    },
    "total_length": {
      "type": ["integer", "null"],
      "minimum": 30,
      "maximum": 400,
      "default": null,
      "description": "motif only: total designed monomer length."
    },
    "binder_length": {
      "type": "integer",
      "minimum": 30,
      "maximum": 200,
      "default": 80
    },
    "num_designs": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 128,
      "default": null,
      "description": "Candidate count. Null preserves the mode-specific default: protein_binder=4, ligand_binder=2, motif=10."
    },
    "seed": {
      "type": ["integer", "null"],
      "default": null
    },
    "run_name": {
      "type": ["string", "null"],
      "default": null
    },
    "search_algorithm": {
      "type": "string",
      "enum": ["default", "single-pass", "best-of-n", "beam-search", "fk-steering", "mcts"],
      "default": "default",
      "description": "Generation search strategy. default preserves the upstream mode config; single-pass is useful for small smoke runs."
    },
    "reward_model": {
      "type": "string",
      "enum": ["default", "none"],
      "default": "default",
      "description": "Reward model policy. default preserves the upstream config; none disables reward scoring/guidance for fast compatibility smoke runs."
    },
    "steps": {
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "enum": ["generate", "filter", "evaluate", "analyze"]
      },
      "minItems": 1,
      "default": null,
      "description": "Optional Proteina-Complexa pipeline steps to run. Null preserves the adapter default for the selected mode; ['generate', 'filter'] is useful for fast design-only smoke runs."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "protein_binder"}}},
      "then": {"required": ["target_pdb"]}
    },
    {
      "if": {"properties": {"mode": {"const": "ligand_binder"}}},
      "then": {
        "required": ["target_pdb", "ligand_smiles"],
        "anyOf": [
          {
            "required": ["target_pocket_residues"],
            "properties": {"target_pocket_residues": {"minItems": 1}}
          },
          {
            "required": ["target_pocket_residue_ids"],
            "properties": {"target_pocket_residue_ids": {"minItems": 1}}
          }
        ]
      }
    },
    {
      "if": {"properties": {"mode": {"const": "motif"}}},
      "then": {
        "required": ["motif_pdb", "total_length"],
        "anyOf": [
          {
            "required": ["motif_residues"],
            "properties": {"motif_residues": {"minItems": 1}}
          },
          {
            "required": ["motif_residue_ids"],
            "properties": {"motif_residue_ids": {"minItems": 1}}
          }
        ]
      }
    }
  ],
  "additionalProperties": false
}
