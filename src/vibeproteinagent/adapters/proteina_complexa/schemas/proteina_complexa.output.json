{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/proteina_complexa.output.json",
  "type": "object",
  "required": ["mode", "designs", "runtime_ms", "num_designs_returned", "seeds_used"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["protein_binder", "ligand_binder", "motif"]
    },
    "designs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pdb_path", "length"],
        "properties": {
          "pdb_path": {"type": "string", "minLength": 1},
          "sequence": {"type": ["string", "null"]},
          "length": {"type": "integer", "minimum": 1},
          "score": {"type": ["number", "null"]},
          "iptm": {"type": ["number", "null"]},
          "plddt": {"type": ["number", "null"]},
          "binder_refold_rmsd": {"type": ["number", "null"]},
          "ligand_contacts": {"type": ["integer", "null"]},
          "ligand_rmsd": {"type": ["number", "null"]},
          "motif_rmsd": {"type": ["number", "null"]},
          "scaffold_plddt": {"type": ["number", "null"]},
          "designability": {"type": ["number", "null"]}
        },
        "additionalProperties": false
      }
    },
    "runtime_ms": {"type": "integer", "minimum": 0},
    "num_designs_returned": {"type": "integer", "minimum": 0},
    "seeds_used": {
      "type": "array",
      "items": {"type": "integer"}
    },
    "position_mappings": {"type": "object", "additionalProperties": true, "default": {}},
    "warnings": {"type": "array", "items": {"type": "string"}, "default": []}
  },
  "additionalProperties": false
}
