{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/prodigy.input.json",
  "type": "object",
  "required": ["pdb_path", "chain_a", "chain_b"],
  "properties": {
    "pdb_path": {"type": "string", "minLength": 1, "vpa:digest": "sha256"},
    "chain_a": {"type": "string", "minLength": 1},
    "chain_b": {"type": "string", "minLength": 1},
    "temperature_k": {"type": "number", "exclusiveMinimum": 0.0, "default": 298.15}
  },
  "additionalProperties": false
}
