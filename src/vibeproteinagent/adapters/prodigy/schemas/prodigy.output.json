{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/prodigy.output.json",
  "type": "object",
  "required": [
    "delta_g_kcal_mol",
    "kd_nm",
    "interface_contacts",
    "runtime_ms"
  ],
  "properties": {
    "delta_g_kcal_mol": {"type": "number"},
    "kd_nm": {"type": "number", "minimum": 0.0},
    "interface_contacts": {"type": "integer", "minimum": 0},
    "candidates": {
      "$comment": "Canonical Candidate v1 items; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "runtime_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
