{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/sequence_analysis.output.json",
  "type": "object",
  "required": [
    "sequence_length",
    "metrics",
    "representative_sequences",
    "liabilities",
    "top_annotations",
    "artifacts",
    "runtime_ms"
  ],
  "properties": {
    "sequence_length": {"type": "integer", "minimum": 0},
    "metrics": {"type": "object"},
    "representative_sequences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "sequence", "length"],
        "properties": {
          "candidate_id": {"type": "string"},
          "index": {"type": "integer", "minimum": 1},
          "header": {"type": ["string", "null"]},
          "sequence": {"type": "string"},
          "length": {"type": "integer", "minimum": 0},
          "gravy": {"type": ["number", "null"]},
          "pI": {"type": ["number", "null"]},
          "net_charge": {"type": ["number", "null"]},
          "liability_count": {"type": "integer", "minimum": 0},
          "liability_types": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "$comment": "Canonical Candidate v1 items; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "candidate_id", "source"],
        "properties": {
          "schema_version": {"const": "candidate_v1"},
          "candidate_id": {"type": "string", "minLength": 1},
          "source": {
            "type": "object",
            "required": ["tool", "local_id"],
            "properties": {
              "tool": {"type": "string", "minLength": 1},
              "node_id": {"type": ["string", "null"], "minLength": 1},
              "job_id": {"type": ["string", "null"], "minLength": 1},
              "local_id": {"type": "string", "minLength": 1},
              "native_id": {"type": ["string", "null"], "minLength": 1},
              "index": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "sequence": {"type": "string", "minLength": 1},
          "structure_path": {"type": "string", "minLength": 1},
          "scores": {
            "type": "object",
            "additionalProperties": {"type": "object", "additionalProperties": true}
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": {"type": "object", "additionalProperties": true}
          }
        },
        "additionalProperties": false
      }
    },
    "liabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "positions", "reason"],
        "properties": {
          "type": {"type": "string"},
          "positions": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "top_annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "position",
          "residue",
          "biochemical_class",
          "charge_class",
          "hydrophobicity_class",
          "aromatic",
          "sulfur_containing",
          "glycine",
          "proline",
          "cysteine",
          "caution_flags"
        ],
        "properties": {
          "position": {"type": "integer", "minimum": 1},
          "residue": {"type": "string"},
          "biochemical_class": {"type": "string"},
          "charge_class": {"type": "string"},
          "hydrophobicity_class": {"type": "string"},
          "aromatic": {"type": "boolean"},
          "sulfur_containing": {"type": "boolean"},
          "glycine": {"type": "boolean"},
          "proline": {"type": "boolean"},
          "cysteine": {"type": "boolean"},
          "caution_flags": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["metrics_json", "residue_annotations_tsv", "summary_json"],
      "properties": {
        "metrics_json": {"type": "string"},
        "residue_annotations_tsv": {"type": ["string", "null"]},
        "summary_json": {"type": "string"},
        "per_sequence_metrics_jsonl": {"type": ["string", "null"], "default": null}
      },
      "additionalProperties": false
    },
    "runtime_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
