{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/colabdesign_utils.input.json",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": ["capabilities"],
      "default": "capabilities"
    },
    "check_import": {
      "type": "boolean",
      "default": false,
      "description": "Also check whether colabdesign is importable in the current Python interpreter. Sidecar runtimes are always probed."
    }
  },
  "additionalProperties": false
}
