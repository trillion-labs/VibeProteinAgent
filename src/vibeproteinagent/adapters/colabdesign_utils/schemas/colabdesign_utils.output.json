{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/colabdesign_utils.output.json",
  "type": "object",
  "required": [
    "action",
    "package_available",
    "utilities",
    "deferred",
    "runtime_ms"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["capabilities"]
    },
    "package_available": {
      "anyOf": [
        {"type": "boolean"},
        {"type": "null"}
      ]
    },
    "import_error": {
      "anyOf": [
        {"type": "string"},
        {"type": "null"}
      ],
      "default": null
    },
    "utilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "reason"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["sidecar_available", "package_available", "unavailable"]
          },
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "deferred": {"type": "boolean"},
    "runtime_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
