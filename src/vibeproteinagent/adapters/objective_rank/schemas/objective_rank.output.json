{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/objective_rank.output.json",
  "type": "object",
  "required": [
    "ranking_intent",
    "objective_name",
    "formula_text",
    "score_direction",
    "gate_summary",
    "candidate_count",
    "ranked_candidates",
    "ranked_json",
    "ranked_tsv",
    "runtime_ms"
  ],
  "properties": {
    "ranking_intent": {"const": "objective"},
    "objective_name": {"type": "string", "minLength": 1},
    "formula_text": {"type": "string", "minLength": 1},
    "score_direction": {"type": "string", "enum": ["higher", "lower"]},
    "gate_summary": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Compact gate descriptions used by report captions."
    },
    "candidate_count": {"type": "integer", "minimum": 1},
    "ranked_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/ranked_candidate"}
    },
    "ranked_json": {"type": "string", "minLength": 1},
    "ranked_tsv": {"type": "string", "minLength": 1},
    "warnings": {"type": "array", "items": {"type": "string"}, "default": []},
    "structured_warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/structured_warning"},
      "default": [],
      "description": "Machine-readable warnings about ranked row identity or evidence completeness."
    },
    "runtime_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false,
  "$defs": {
    "gate_record": {"type": "object", "additionalProperties": true},
    "score_component": {"type": "object", "additionalProperties": true},
    "structured_warning": {
      "type": "object",
      "required": ["code", "severity", "message", "candidate_id", "ranked_candidate_id"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["warning"]},
        "message": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "ranked_candidate_id": {"type": "string", "minLength": 1},
        "present_fields": {"type": "array", "items": {"type": "string"}},
        "required_any_of": {"type": "array", "items": {"type": "string"}},
        "score_namespaces": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "candidate_ref": {
      "type": "object",
      "required": ["candidate_id", "ranked_candidate_id"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "ranked_candidate_id": {"type": "string", "minLength": 1},
        "identity_key": {"type": "string"},
        "material_key": {"type": "string"},
        "source_job_ids": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "object", "additionalProperties": true},
        "material_identity": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "ranked_candidate": {
      "type": "object",
      "required": [
        "rank",
        "candidate_id",
        "ranked_candidate_id",
        "objective_score",
        "objective_name",
        "score_formula",
        "formula_text",
        "score_direction",
        "score_components",
        "passed_gates",
        "failed_gates",
        "tie_breaker_values",
        "candidate_ref"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "ranked_candidate_id": {"type": "string", "minLength": 1},
        "objective_score": {"type": ["number", "null"]},
        "objective_name": {"type": "string", "minLength": 1},
        "score_formula": {"type": "string", "minLength": 1},
        "formula_text": {"type": "string", "minLength": 1},
        "score_direction": {"type": "string", "enum": ["higher", "lower"]},
        "gate_summary": {"type": "array", "items": {"type": "string"}},
        "score_components": {"type": "array", "items": {"$ref": "#/$defs/score_component"}},
        "passed_gates": {"type": "array", "items": {"$ref": "#/$defs/gate_record"}},
        "failed_gates": {"type": "array", "items": {"$ref": "#/$defs/gate_record"}},
        "tie_breaker_values": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
        "structured_warnings": {
          "type": "array",
          "items": {"$ref": "#/$defs/structured_warning"},
          "default": []
        },
        "candidate_ref": {"$ref": "#/$defs/candidate_ref"}
      },
      "additionalProperties": true
    }
  }
}
