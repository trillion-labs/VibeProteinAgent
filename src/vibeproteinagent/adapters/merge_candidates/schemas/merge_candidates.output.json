{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/merge_candidates.output.json",
  "type": "object",
  "required": ["candidates", "merge_audit"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate_v1"}
    },
    "merge_audit": {
      "type": "object",
      "required": ["input_counts", "output_count", "dedup_policy"],
      "properties": {
        "input_counts": {"type": "array", "items": {"type": "integer"}},
        "output_count": {"type": "integer"},
        "dedup_policy": {"type": "string", "enum": ["keep_all"]},
        "duplicates_removed": {"type": "integer"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "candidate_v1": {
      "$comment": "Canonical Candidate v1; mirrors src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "object",
      "required": ["schema_version", "candidate_id", "source"],
      "properties": {
        "schema_version": {"const": "candidate_v1"},
        "candidate_id": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "required": ["tool", "local_id"],
          "properties": {
            "tool": {"type": "string", "minLength": 1},
            "node_id": {"type": ["string", "null"], "minLength": 1},
            "job_id": {"type": ["string", "null"], "minLength": 1},
            "local_id": {"type": "string", "minLength": 1},
            "native_id": {"type": ["string", "null"], "minLength": 1},
            "index": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "sequence": {"type": "string", "minLength": 1},
        "structure_path": {"type": "string", "minLength": 1},
        "backbone_path": {"type": "string", "minLength": 1},
        "full_structure_path": {"type": "string", "minLength": 1},
        "scores": {
          "type": "object",
          "additionalProperties": {"type": "object", "additionalProperties": true},
          "default": {}
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": {"type": "object", "additionalProperties": true},
          "default": {}
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "has_sequence": {"type": "boolean"},
            "has_backbone_structure": {"type": "boolean"},
            "has_full_structure": {"type": "boolean"},
            "has_candidate_scores": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
