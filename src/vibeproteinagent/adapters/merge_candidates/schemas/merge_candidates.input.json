{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/merge_candidates.input.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_sets"],
  "properties": {
    "candidate_sets": {
      "type": "array",
      "minItems": 1,
      "description": "Two or more lists of canonical Candidate v1 records to combine into a single flat candidate list. Each inner list is one upstream tool's output (e.g. one MPNN run and one BoltzGen run).",
      "examples": [[[{"schema_version": "candidate_v1", "candidate_id": "c0", "source": {"tool": "proteinmpnn", "local_id": "0"}}], [{"schema_version": "candidate_v1", "candidate_id": "c1", "source": {"tool": "boltzgen", "local_id": "0"}}]]],
      "items": {
        "type": "array",
        "items": {"$ref": "#/$defs/candidate_v1"}
      }
    },
    "dedup_policy": {
      "type": "string",
      "enum": ["keep_all"],
      "default": "keep_all",
      "description": "Deduplication strategy across input lists. Currently only `keep_all` is supported — all candidates are preserved in input order.",
      "examples": ["keep_all"]
    }
  },
  "$defs": {
    "candidate_v1": {
      "$comment": "Canonical Candidate v1; mirrors src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "object",
      "required": ["schema_version", "candidate_id", "source"],
      "properties": {
        "schema_version": {"const": "candidate_v1"},
        "candidate_id": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "required": ["tool", "local_id"],
          "properties": {
            "tool": {"type": "string", "minLength": 1},
            "node_id": {"type": ["string", "null"], "minLength": 1},
            "job_id": {"type": ["string", "null"], "minLength": 1},
            "local_id": {"type": "string", "minLength": 1},
            "native_id": {"type": ["string", "null"], "minLength": 1},
            "index": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "sequence": {"type": "string", "minLength": 1},
        "structure_path": {"type": "string", "minLength": 1},
        "backbone_path": {"type": "string", "minLength": 1},
        "full_structure_path": {"type": "string", "minLength": 1},
        "scores": {
          "type": "object",
          "additionalProperties": {"type": "object", "additionalProperties": true},
          "default": {}
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": {"type": "object", "additionalProperties": true},
          "default": {}
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "has_sequence": {"type": "boolean"},
            "has_backbone_structure": {"type": "boolean"},
            "has_full_structure": {"type": "boolean"},
            "has_candidate_scores": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
