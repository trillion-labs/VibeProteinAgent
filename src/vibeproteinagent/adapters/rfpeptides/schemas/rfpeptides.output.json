{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/rfpeptides.output.json",
  "type": "object",
  "required": [
    "designs",
    "runtime_ms",
    "num_designs_returned"
  ],
  "properties": {
    "designs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pdb_path", "length"],
        "properties": {
          "pdb_path": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute path to the design PDB. Backbone-only with glycine residues (sequences must be designed downstream via ProteinMPNN)."
          },
          "trb_path": {
            "type": ["string", "null"],
            "description": "Path to the corresponding ``.trb`` metadata pickle written by RFdiffusion."
          },
          "sequence": {
            "type": ["string", "null"],
            "description": "Always null — RFdiffusion writes glycine placeholders; sequence design happens downstream."
          },
          "length": {"type": "integer", "minimum": 1},
          "score": {
            "type": ["number", "null"],
            "description": "Always null — RFdiffusion does not emit a scalar score."
          }
        },
        "additionalProperties": false
      }
    },
    "runtime_ms": {"type": "integer", "minimum": 0},
    "num_designs_returned": {"type": "integer", "minimum": 0},
    "position_mappings": {"type": "object", "additionalProperties": true, "default": {}},
    "warnings": {"type": "array", "items": {"type": "string"}, "default": []}
  },
  "additionalProperties": false
}
