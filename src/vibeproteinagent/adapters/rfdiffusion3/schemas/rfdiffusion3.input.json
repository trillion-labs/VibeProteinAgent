{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/rfdiffusion3.input.json",
  "type": "object",
  "required": ["target_pdb"],
  "properties": {
    "target_pdb": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the target structure (.pdb) the binder is designed against.",
      "vpa:digest": "sha256"
    },
    "target_chain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1,
      "default": "A"
    },
    "target_hotspots": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "default": []
    },
    "binder_length": {
      "type": "integer",
      "minimum": 30,
      "maximum": 200,
      "default": 60
    },
    "num_designs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "default": 8
    },
    "num_diffusion_steps": {
      "type": "integer",
      "minimum": 10,
      "maximum": 200,
      "default": 200
    },
    "seed": {
      "type": ["integer", "null"],
      "default": null
    }
  },
  "additionalProperties": false
}
