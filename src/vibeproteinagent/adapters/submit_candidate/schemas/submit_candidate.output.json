{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/submit_candidate.output.json",
  "type": "object",
  "required": [
    "submission_id",
    "outcome",
    "terminal",
    "candidates_resolved",
    "reasoning",
    "auto_selected",
    "runtime_ms"
  ],
  "properties": {
    "submission_id": {"type": "string", "minLength": 1},
    "outcome": {
      "type": "string",
      "enum": ["accepted", "no_acceptable_candidate"]
    },
    "terminal": {"type": "boolean", "const": true},
    "candidates_resolved": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "reasoning": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"]},
    "auto_selected": {"type": "boolean", "const": false},
    "runtime_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
