{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/rfdiffusion.output.json",
  "type": "object",
  "required": [
    "mode",
    "contigs",
    "designs",
    "backbone_dir",
    "manifest_jsonl",
    "top_candidates",
    "runtime_ms",
    "num_requested",
    "num_generated",
    "num_designs_returned"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "unconditional",
        "motif_scaffolding",
        "symmetric_motif_scaffolding",
        "partial_diffusion",
        "binder_design",
        "fold_conditioning",
        "symmetric_oligomer"
      ]
    },
    "contigs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "designs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pdb_path", "length"],
        "properties": {
          "pdb_path": {"type": "string", "minLength": 1},
          "trb_path": {"type": ["string", "null"], "default": null},
          "sequence": {"type": ["string", "null"], "default": null},
          "length": {"type": "integer", "minimum": 1},
          "score": {"type": ["number", "null"], "default": null}
        },
        "additionalProperties": false
      }
    },
    "backbone_dir": {"type": "string", "minLength": 1},
    "manifest_jsonl": {"type": "string", "minLength": 1},
    "top_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pdb_path", "length"],
        "properties": {
          "pdb_path": {"type": "string", "minLength": 1},
          "trb_path": {"type": ["string", "null"], "default": null},
          "sequence": {"type": ["string", "null"], "default": null},
          "length": {"type": "integer", "minimum": 1},
          "score": {"type": ["number", "null"], "default": null}
        },
        "additionalProperties": false
      }
    },
    "runtime_ms": {"type": "integer", "minimum": 0},
    "num_requested": {"type": "integer", "minimum": 0},
    "num_generated": {"type": "integer", "minimum": 0},
    "num_designs_returned": {"type": "integer", "minimum": 0},
    "position_mappings": {"type": "object", "additionalProperties": true, "default": {}},
    "warnings": {"type": "array", "items": {"type": "string"}, "default": []}
  },
  "additionalProperties": false
}
