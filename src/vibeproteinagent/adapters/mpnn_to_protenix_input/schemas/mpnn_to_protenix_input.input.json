{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/mpnn_to_protenix_input.input.json",
  "type": "object",
  "required": ["designs_fasta"],
  "properties": {
    "designs_fasta": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path to a ProteinMPNN-format FASTA emitted by the proteinmpnn adapter.",
      "vpa:digest": "sha256"
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024,
      "default": 1
    },
    "name_prefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "default": "design"
    }
  },
  "additionalProperties": false
}
