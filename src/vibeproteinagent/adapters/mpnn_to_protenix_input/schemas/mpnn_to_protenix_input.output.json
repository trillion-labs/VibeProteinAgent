{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/mpnn_to_protenix_input.output.json",
  "type": "object",
  "required": ["input_jsons", "names", "candidates", "count"],
  "properties": {
    "input_jsons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "names": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "candidate_id", "sequence", "source"],
        "properties": {
          "schema_version": {"const": "candidate_v1"},
          "candidate_id": {"type": "string", "minLength": 1},
          "sequence": {"type": "string", "minLength": 1},
          "structure_path": {"type": "string", "minLength": 1},
          "backbone_path": {"type": "string", "minLength": 1},
          "full_structure_path": {"type": "string", "minLength": 1},
          "scores": {
            "type": "object",
            "additionalProperties": {"type": "object", "additionalProperties": true},
            "default": {}
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": {"type": "object", "additionalProperties": true},
            "default": {}
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "has_sequence": {"type": "boolean"},
              "has_backbone_structure": {"type": "boolean"},
              "has_full_structure": {"type": "boolean"},
              "has_candidate_scores": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "required": ["tool", "local_id"],
            "properties": {
              "tool": {"type": "string", "minLength": 1},
              "node_id": {"type": ["string", "null"], "minLength": 1},
              "job_id": {"type": ["string", "null"], "minLength": 1},
              "local_id": {"type": "string", "minLength": 1},
              "native_id": {"type": ["string", "null"], "minLength": 1},
              "index": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "score": {"type": ["number", "null"]},
          "source_header": {"type": ["string", "null"]},
          "protenix_input_json": {"type": "string", "minLength": 1},
          "protenix_name": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
