{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/pxmeter.output.json",
  "type": "object",
  "required": ["metrics", "report_json_path", "runtime_ms"],
  "properties": {
    "metrics": {
      "type": "object",
      "properties": {
        "lddt": {"type": ["number", "null"]},
        "dockq": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["chain_pair", "score"],
            "properties": {
              "chain_pair": {"type": "string", "minLength": 1},
              "score": {"type": "number"}
            },
            "additionalProperties": true
          }
        },
        "per_chain_lddt": {
          "type": ["object", "null"],
          "additionalProperties": {"type": "number"}
        },
        "per_interface_lddt": {
          "type": ["object", "null"],
          "additionalProperties": {"type": "number"}
        }
      },
      "additionalProperties": true
    },
    "report_json_path": {"type": "string", "minLength": 1},
    "candidates": {
      "$comment": "Canonical Candidate v1 items; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "runtime_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
