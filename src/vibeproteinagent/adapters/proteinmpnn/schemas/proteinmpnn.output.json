{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/proteinmpnn.output.json",
  "type": "object",
  "required": ["designs", "designs_fasta", "log_prob_npz", "num_residues", "runtime_ms"],
  "properties": {
    "designs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sequence", "score"],
        "properties": {
          "sequence": {"type": "string", "minLength": 1},
          "score": {"type": "number"},
          "seq_recovery": {"type": ["number", "null"]}
        },
        "additionalProperties": false
      }
    },
    "designs_fasta": {"type": "string", "minLength": 1},
    "log_prob_npz": {"type": "string", "minLength": 1},
    "num_residues": {"type": "integer", "minimum": 1},
    "runtime_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
