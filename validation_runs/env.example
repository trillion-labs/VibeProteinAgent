# Copy to validation_runs/local.env for private runs.
# Do not commit local.env or real credential values.

# Optional when submitting from outside the repository.
# export VPA_REPO_ROOT=/path/to/VibeProteinAgent

# Prefer an installed CLI. If unset, common.sh tries:
# 1. $VPA_REPO_ROOT/.venv/bin/vpa
# 2. vpa on PATH
# 3. $VPA_PYTHON -m vibeproteinagent.cli.main
# export VPA_BIN=/path/to/vpa
# export VPA_PYTHON=/path/to/python

# Persistent caches. Keep these outside isolated validation workspaces.
# export VPA_MODEL_CACHE=${HOME}/.cache/vibeproteinagent/models
# export HF_HOME=${HOME}/.cache/huggingface
# export TORCH_HOME=${HOME}/.cache/torch

# Optional pre-provisioned model/tool assets for real GPU validation.
# export VPA_PROTENIX_TREE=/path/to/protenix-v2
# export VPA_PROTENIX_CKPT=/path/to/protenix-cache
# export VPA_RFDIFFUSION_TREE=/path/to/rfdiffusion
# export VPA_RFDIFFUSION_WEIGHTS=/path/to/rfdiffusion-weights

# Credentials. Keep values private.
# export HF_TOKEN=<huggingface-token>
# export VPA_HF_CREDENTIAL=<huggingface-token>
# export OPENROUTER_API_KEY=<openrouter-api-key>
# export VPA_OPENROUTER_CREDENTIAL=<openrouter-api-key>

# LLM agent scenario defaults.
# export VPA_VALIDATION_CODEX_MODEL=gpt-5.2
# export VPA_VALIDATION_CLAUDE_MODEL=sonnet
# export VPA_VALIDATION_OPENROUTER_MODEL=qwen/qwen3-8b
# export VPA_AGENT_TIMEOUT_S=300

# Local CLI provider wrappers, if needed on the Slurm image.
# export VPA_CODEX_COMMAND=codex
# export VPA_CODEX_ARGS="exec --model {model} --skip-git-repo-check --sandbox read-only -"
# export VPA_CLAUDE_CODE_COMMAND=claude
# export VPA_CLAUDE_CODE_ARGS="-p --model {model} --output-format text"

# Slurm/runtime controls.
# export VPA_VALIDATION_RUN_ROOT=/scratch/${USER}/vpa_validation
# export VPA_VALIDATION_GPUS=0,1,2,3,4,5,6,7
# export VPA_VALIDATION_WORKERS=8
# export VPA_VALIDATION_TIMEOUT_MS=7200000
# export VPA_VALIDATION_MAX_WAIT_S=7200
