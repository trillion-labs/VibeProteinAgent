{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/ligandmpnn.input.json",
  "type": "object",
  "required": ["pdb_path"],
  "properties": {
    "pdb_path": {"type": "string", "minLength": 1, "vpa:digest": "sha256"},
    "candidates": {"type": "array", "items": {"type": "object", "additionalProperties": true}, "default": []},
    "chains": {
      "type": ["array", "null"],
      "items": {"type": "string", "minLength": 1},
      "default": null
    },
    "num_designs": {"type": "integer", "minimum": 1, "maximum": 1024, "default": 8},
    "temperature": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 2.0, "default": 0.1},
    "omit_aas": {"type": "string", "default": "X"},
    "seed": {"type": ["integer", "null"], "default": null},
    "model_type": {
      "type": "string",
      "enum": ["protein_mpnn", "ligand_mpnn", "soluble_mpnn", "ca_mpnn"],
      "default": "ligand_mpnn"
    },
    "redesigned_residues": {"type": ["string", "null"], "default": null, "description": "Explicit structure residue IDs such as A10 A11 B25."},
    "redesigned_positions": {"type": "array", "items": {"type": "integer", "minimum": 1}, "default": [], "description": "FASTA/sequence 1-indexed positions to redesign when sequence/fasta_path is provided."},
    "sequence": {"type": ["string", "null"], "default": null},
    "fasta_path": {"type": ["string", "null"], "minLength": 1, "default": null, "vpa:digest": "sha256-if-path"},
    "position_basis": {"type": "string", "enum": ["auto", "sequence", "structure"], "default": "auto"}
  },
  "additionalProperties": false
}
