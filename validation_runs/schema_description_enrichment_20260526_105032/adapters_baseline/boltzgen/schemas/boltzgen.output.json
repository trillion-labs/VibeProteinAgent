{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/boltzgen.output.json",
  "type": "object",
  "required": [
    "designs",
    "runtime_ms",
    "num_designs_returned",
    "seeds_used"
  ],
  "properties": {
    "designs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cif_path", "length"],
        "properties": {
          "candidate_id": {"type": ["string", "null"], "minLength": 1},
          "cif_path": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute path to the design CIF (backbone after the design step; refolded complex after the full pipeline)."
          },
          "pdb_path": {"type": ["string", "null"]},
          "sequence": {
            "type": ["string", "null"],
            "description": "Designed binder sequence (populated only after the inverse_fold step)."
          },
          "length": {"type": "integer", "minimum": 1},
          "score": {
            "type": ["number", "null"],
            "description": "Aggregate quality score (populated only after the full pipeline)."
          },
          "affinity_pred_value": {
            "type": ["number", "null"],
            "description": "Predicted log10 IC50 (uM) from the Boltz-2 affinity head (only for protein-small_molecule)."
          },
          "affinity_probability_binary": {
            "type": ["number", "null"],
            "minimum": 0.0,
            "maximum": 1.0
          },
          "confidence": {
            "type": ["number", "null"],
            "description": "Refolding confidence (ipTM blend from Boltz-2; null in design-only mode)."
          }
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "$comment": "Canonical Candidate v1 items; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "runtime_ms": {"type": "integer", "minimum": 0},
    "num_designs_returned": {"type": "integer", "minimum": 0},
    "seeds_used": {
      "type": "array",
      "items": {"type": "integer"}
    }
  },
  "additionalProperties": false
}
