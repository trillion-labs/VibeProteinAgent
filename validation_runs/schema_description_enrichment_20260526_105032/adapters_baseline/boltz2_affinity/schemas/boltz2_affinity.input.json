{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/boltz2_affinity.input.json",
  "type": "object",
  "oneOf": [
    {"required": ["input_yaml"]},
    {"required": ["sequences"]},
    {"required": ["candidates"]}
  ],
  "properties": {
    "input_yaml": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path to a Boltz-format YAML describing protein chain(s) + ligand and (optionally) the affinity property to score.",
      "vpa:digest": "sha256-if-path"
    },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "description": "Inline list of typed inputs Boltz accepts. Mutually exclusive with input_yaml.",
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "enum": ["protein", "rna", "dna", "ligand"]},
          "id": {
            "oneOf": [
              {"type": "string"},
              {"type": "array", "items": {"type": "string"}}
            ]
          },
          "sequence": {"type": "string"},
          "smiles": {"type": "string"},
          "ccd": {"type": "string"},
          "msa": {"type": "string"},
          "binder": {"type": "boolean"}
        },
        "required": ["type", "id"],
        "additionalProperties": false
      }
    },
    "candidates": {
      "$comment": "Canonical Candidate v1 input accepted additively; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "binder_chain": {
      "type": "string",
      "description": "Chain id of the binder ligand to score for affinity. Required when using `sequences`; ignored when `input_yaml` already declares a `properties.affinity` block."
    },
    "seeds": {
      "type": "array",
      "items": {"type": "integer"},
      "minItems": 1,
      "default": [42]
    },
    "recycling_steps": {"type": "integer", "minimum": 1, "maximum": 20, "default": 3},
    "sampling_steps": {"type": "integer", "minimum": 5, "maximum": 1000, "default": 200},
    "diffusion_samples": {"type": "integer", "minimum": 1, "maximum": 25, "default": 1},
    "sampling_steps_affinity": {"type": "integer", "minimum": 5, "maximum": 1000, "default": 200},
    "diffusion_samples_affinity": {"type": "integer", "minimum": 1, "maximum": 25, "default": 3},
    "use_msa": {"type": "boolean", "default": false},
    "msa_backend": {
      "type": "string",
      "enum": ["auto", "none", "remote"],
      "default": "auto",
      "description": "MSA backend policy. With use_msa=true, auto uses a prepared MSA if present and otherwise falls back to the remote ColabFold server; none disables MSA; remote always calls the remote MSA server."
    },
    "affinity_mw_correction": {"type": "boolean", "default": false}
  },
  "additionalProperties": false
}
