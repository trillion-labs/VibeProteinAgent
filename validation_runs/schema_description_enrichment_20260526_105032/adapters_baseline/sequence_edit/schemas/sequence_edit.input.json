{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/sequence_edit.input.json",
  "type": "object",
  "required": ["operation"],
  "properties": {
    "operation": {"type": "string", "enum": ["mutate_residues", "check_wt_consistency"]},
    "candidates": {"type": "array", "items": {"type": "object", "additionalProperties": true}, "default": []},
    "sequence": {"type": ["string", "null"], "default": null},
    "wild_type_sequence": {"type": ["string", "null"], "default": null},
    "mutant_sequence": {"type": ["string", "null"], "default": null},
    "mapping": {
      "type": "object",
      "propertyNames": {"pattern": "^[1-9][0-9]*$"},
      "additionalProperties": {"type": "string", "pattern": "^[A-Za-z]$"},
      "default": {}
    },
    "mutation_notation": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z][1-9][0-9]*[A-Za-z]$"},
      "uniqueItems": true,
      "default": []
    },
    "allow_noop": {"type": "boolean", "default": false},
    "strict_wild_type": {"type": "boolean", "default": true},
    "output_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "default": "mutant"}
  },
  "additionalProperties": false
}
