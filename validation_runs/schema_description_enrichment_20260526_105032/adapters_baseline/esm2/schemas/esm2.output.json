{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/esm2.output.json",
  "type": "object",
  "required": [
    "num_residues",
    "model_name",
    "mode",
    "generated_sequences",
    "filled_positions",
    "fallback_used",
    "runtime_ms"
  ],
  "properties": {
    "per_residue_embeddings_npz": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ],
      "default": null
    },
    "pooled_embedding": {
      "anyOf": [
        {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 1
        },
        {"type": "null"}
      ],
      "default": null
    },
    "generated_sequences": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "candidates": {
      "$comment": "Canonical Candidate v1 output emitted additively; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "filled_positions": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "default": []
    },
    "generation_strategy": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ],
      "default": null
    },
    "fallback_used": {"type": "boolean", "default": false},
    "num_residues": {"type": "integer", "minimum": 1},
    "model_name": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["embedding", "sequence_generation"]},
    "runtime_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
