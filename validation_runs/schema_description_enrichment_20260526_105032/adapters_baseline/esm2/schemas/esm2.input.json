{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/esm2.input.json",
  "type": "object",
  "anyOf": [
    {"required": ["sequence"]},
    {"required": ["candidates"]}
  ],
  "properties": {
    "sequence": {"type": "string", "minLength": 1},
    "candidates": {
      "$comment": "Canonical Candidate v1 input accepted additively; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "mode": {
      "type": "string",
      "enum": ["embedding", "sequence_generation"],
      "default": "embedding"
    },
    "model_name": {
      "type": "string",
      "minLength": 1,
      "default": "facebook/esm2_t12_35M_UR50D"
    },
    "return_attention": {"type": "boolean", "default": false},
    "mask_positions": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "uniqueItems": true,
      "default": [],
      "description": "FASTA/sequence 1-indexed positions to mask."
    },
    "mask_indices_zero_based": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0},
      "uniqueItems": true,
      "default": [],
      "description": "Advanced compatibility field for zero-based mask indices."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "sequence_generation"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "sequence": {"pattern": "^[ACDEFGHIKLMNPQRSTVWYX?_.-]+$"}
        }
      },
      "else": {
        "properties": {
          "sequence": {"pattern": "^[ACDEFGHIKLMNPQRSTVWYX]+$"}
        }
      }
    }
  ]
}
