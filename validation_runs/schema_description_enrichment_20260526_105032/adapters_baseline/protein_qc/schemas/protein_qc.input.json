{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/protein_qc.input.json",
  "type": "object",
  "anyOf": [
    {"required": ["sequence"]},
    {"required": ["pdb_path"]},
    {"required": ["candidates"]}
  ],
  "properties": {
    "sequence": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z]*$",
      "default": null
    },
    "pdb_path": {"type": ["string", "null"], "default": null, "vpa:digest": "sha256-if-path"},
    "candidates": {
      "$comment": "Canonical Candidate v1 input accepted additively; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["plddt", "polybasic", "gravy", "instability_index", "pi"]
      },
      "uniqueItems": true,
      "default": ["plddt", "polybasic", "gravy", "instability_index", "pi"]
    }
  },
  "additionalProperties": false
}
