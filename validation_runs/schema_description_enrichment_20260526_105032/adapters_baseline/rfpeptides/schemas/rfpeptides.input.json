{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/rfpeptides.input.json",
  "type": "object",
  "required": ["peptide_length"],
  "properties": {
    "target_pdb": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Optional target structure (.pdb). When provided, the adapter runs in macrocyclic binder mode; otherwise monomer macrocycle mode.",
      "vpa:digest": "sha256-if-path"
    },
    "candidates": {"type": "array", "items": {"type": "object", "additionalProperties": true}, "default": []},
    "target_chain": {
      "type": "string",
      "minLength": 1,
      "default": "A",
      "description": "Target chain id in the input PDB. Used only when ``target_pdb`` is provided."
    },
    "target_residues": {
      "type": ["string", "null"],
      "description": "Optional FASTA/sequence 1-indexed target range when target_sequence/target_fasta_path is provided; otherwise legacy structure residue range.",
      "pattern": "^[0-9]+-[0-9]+$"
    },
    "target_hotspots": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "default": [],
      "description": "Optional FASTA/sequence 1-indexed target positions when target_sequence/target_fasta_path is provided; otherwise legacy structure residue numbers."
    },
    "target_hotspot_residue_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "target_sequence": {
      "type": ["string", "null"],
      "default": null
    },
    "target_fasta_path": {
      "type": ["string", "null"],
      "minLength": 1,
      "default": null,
      "vpa:digest": "sha256-if-path"
    },
    "position_basis": {
      "type": "string",
      "enum": ["auto", "sequence", "structure"],
      "default": "auto"
    },
    "peptide_length": {
      "type": "integer",
      "minimum": 5,
      "maximum": 50,
      "default": 10,
      "description": "Fixed length of the macrocyclic peptide chain."
    },
    "num_designs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "default": 10
    },
    "num_diffusion_steps": {
      "type": "integer",
      "minimum": 10,
      "maximum": 200,
      "default": 50,
      "description": "RFdiffusion ``diffuser.T`` parameter."
    },
    "noise_scale": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 1.0,
      "description": "Translation+rotation noise scale during sampling. Lower means tighter, less diverse."
    },
    "seed": {
      "type": ["integer", "null"],
      "default": null
    }
  },
  "additionalProperties": false
}
