{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/template_select.input.json",
  "type": "object",
  "required": ["template_db"],
  "properties": {
    "query_sequence": {"type": ["string", "null"], "default": null},
    "query_fasta": {"type": ["string", "null"], "default": null, "vpa:digest": "sha256-if-path"},
    "query_structure": {"type": ["string", "null"], "default": null, "vpa:digest": "sha256-if-path"},
    "candidates": {"type": "array", "items": {"type": "object", "additionalProperties": true}, "default": []},
    "template_db": {"type": "string", "minLength": 1, "vpa:digest": "sha256-if-path"},
    "template_db_kind": {"type": "string", "enum": ["fasta", "mmseqs", "foldseek"], "default": "fasta"},
    "max_templates": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 50},
    "min_identity": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.2},
    "min_coverage": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5},
    "max_evalue": {"type": "number", "exclusiveMinimum": 0, "default": 0.001},
    "temporal_cutoff": {"type": ["string", "null"], "default": null},
    "metadata_table": {"type": ["string", "null"], "default": null, "vpa:digest": "sha256-if-path"}
  },
  "anyOf": [{"required": ["query_sequence"]}, {"required": ["query_fasta"]}, {"required": ["query_structure"]}, {"required": ["candidates"]}],
  "additionalProperties": false
}
