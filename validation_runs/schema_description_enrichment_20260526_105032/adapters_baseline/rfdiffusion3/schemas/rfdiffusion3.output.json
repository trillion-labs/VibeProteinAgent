{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/rfdiffusion3.output.json",
  "type": "object",
  "required": [
    "designs",
    "runtime_ms",
    "num_designs_returned"
  ],
  "properties": {
    "designs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pdb_path", "length"],
        "properties": {
          "pdb_path": {"type": "string", "minLength": 1},
          "sequence": {"type": ["string", "null"]},
          "length": {"type": "integer", "minimum": 1},
          "score": {"type": ["number", "null"]}
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "$comment": "Canonical Candidate v1 items; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "runtime_ms": {"type": "integer", "minimum": 0},
    "num_designs_returned": {"type": "integer", "minimum": 0},
    "position_mappings": {"type": "object", "additionalProperties": true, "default": {}},
    "warnings": {"type": "array", "items": {"type": "string"}, "default": []}
  },
  "additionalProperties": false
}
