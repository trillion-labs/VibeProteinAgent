{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/sequence_analysis.input.json",
  "type": "object",
  "anyOf": [
    {"required": ["sequence"]},
    {"required": ["fasta_path"]},
    {"required": ["candidates"]}
  ],
  "properties": {
    "sequence": {"type": "string", "minLength": 1},
    "fasta_path": {
      "type": "string",
      "minLength": 1,
      "vpa:digest": "sha256-if-path"
    },
    "candidates": {
      "$comment": "Canonical Candidate v1 input accepted additively; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "positions": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "uniqueItems": true,
      "default": []
    },
    "ph": {"type": "number", "minimum": 0.0, "maximum": 14.0, "default": 7.4},
    "max_annotations": {"type": "integer", "minimum": 0, "default": 100},
    "include_regions": {"type": "boolean", "default": true},
    "include_residue_table": {"type": "boolean", "default": true},
    "output_prefix": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "default": "sequence_analysis"}
  },
  "additionalProperties": false
}
