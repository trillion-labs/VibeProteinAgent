{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/esm3.output.json",
  "type": "object",
  "required": ["num_residues", "model_name", "runtime_ms"],
  "properties": {
    "per_residue_embeddings_npz": {"type": ["string", "null"], "minLength": 1},
    "predicted_pdb": {"type": ["string", "null"], "minLength": 1},
    "confidence_scores": {
      "type": ["object", "null"],
      "properties": {
        "mean_plddt": {"type": ["number", "null"]},
        "ptm": {"type": ["number", "null"]}
      },
      "additionalProperties": true
    },
    "candidates": {
      "$comment": "Canonical Candidate v1 output emitted additively; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "num_residues": {"type": "integer", "minimum": 1},
    "model_name": {"type": "string", "minLength": 1},
    "runtime_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
