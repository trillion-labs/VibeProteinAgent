{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/pxmeter.input.json",
  "type": "object",
  "anyOf": [
    {"required": ["predicted_cif", "reference_cif"]},
    {"required": ["candidates"]}
  ],
  "properties": {
    "predicted_cif": {"type": "string", "minLength": 1, "vpa:digest": "sha256"},
    "reference_cif": {"type": "string", "minLength": 1, "vpa:digest": "sha256"},
    "candidates": {
      "$comment": "Canonical Candidate v1 input accepted additively; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "metrics": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": ["lddt", "dockq"]
    },
    "chain_pairs": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["a", "b"],
        "properties": {
          "a": {"type": "string", "minLength": 1},
          "b": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "default": null
    }
  },
  "additionalProperties": false
}
