{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeproteinagent.dev/schemas/mmseqs2_gpu.output.json",
  "type": "object",
  "required": ["hits_tsv", "num_hits", "runtime_ms"],
  "properties": {
    "hits_tsv": {"type": "string", "minLength": 1},
    "num_hits": {"type": "integer", "minimum": 0},
    "candidates": {
      "$comment": "Canonical Candidate v1 items; see src/vibeproteinagent/schemas/candidate_v1.json.",
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "runtime_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
