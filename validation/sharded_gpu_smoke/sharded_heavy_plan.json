{
  "mode": "agent_plan",
  "goal": "Sharded GPU smoke: exercise heavy single-GPU tools as foreach shards with bounded concurrency.",
  "assumptions": [
    "This plan validates workflow-level sharding, not true multi-GPU execution inside one adapter process.",
    "Each shard uses a tiny seed/sample budget and should run on one GPU worker when the required sidecars are installed."
  ],
  "missing_inputs": [],
  "required_tools": [
    "boltz2_affinity",
    "boltzgen",
    "proteina_complexa",
    "protenix_v2",
    "rank_designs"
  ],
  "workflow_plan": {
    "name": "sharded_gpu_heavy_smoke",
    "version": "0.1.0",
    "description": "Tiny foreach fan-out smoke for heavy model adapters and aggregate ranking.",
    "params": {
      "boltz_yaml": {"type": "path", "required": true},
      "protenix_json": {"type": "path", "required": true},
      "complex_pdb": {"type": "path", "required": true},
      "protenix_seed_jobs": {
        "type": "list",
        "required": false,
        "default": [{"seeds": [101]}, {"seeds": [103]}]
      },
      "boltz_seed_jobs": {
        "type": "list",
        "required": false,
        "default": [{"seeds": [42]}, {"seeds": [44]}]
      },
      "boltzgen_jobs": {
        "type": "list",
        "required": false,
        "default": [{"seed": 201, "suffix": "a"}, {"seed": 203, "suffix": "b"}]
      },
      "proteina_complexa_jobs": {
        "type": "list",
        "required": false,
        "default": [
          {"seed": 301, "run_name": "sharded_pc_301"},
          {"seed": 303, "run_name": "sharded_pc_303"}
        ]
      }
    },
    "nodes": [
      {
        "id": "protenix_shards",
        "tool": "protenix_v2",
        "foreach": "${params.protenix_seed_jobs}",
        "max_parallel": 2,
        "inputs": {
          "input_json": "${params.protenix_json}",
          "seeds": "${item.seeds}",
          "use_msa": false,
          "use_template": false,
          "n_sample": 1,
          "n_step": 10,
          "n_cycle": 1
        },
        "on_failure": "continue"
      },
      {
        "id": "boltz2_shards",
        "tool": "boltz2_affinity",
        "foreach": "${params.boltz_seed_jobs}",
        "max_parallel": 2,
        "inputs": {
          "input_yaml": "${params.boltz_yaml}",
          "seeds": "${item.seeds}",
          "recycling_steps": 1,
          "sampling_steps": 20,
          "diffusion_samples": 1,
          "sampling_steps_affinity": 20,
          "diffusion_samples_affinity": 1,
          "use_msa": false,
          "affinity_mw_correction": false
        },
        "on_failure": "continue"
      },
      {
        "id": "boltzgen_shards",
        "tool": "boltzgen",
        "foreach": "${params.boltzgen_jobs}",
        "max_parallel": 2,
        "inputs": {
          "target_pdb": "${params.complex_pdb}",
          "target_chain": "A",
          "binder_length": 20,
          "num_designs": 1,
          "num_diffusion_steps": 10,
          "protocol": "protein-anything",
          "design_only": true,
          "budget": 1,
          "seed": "${item.seed}"
        },
        "on_failure": "continue"
      },
      {
        "id": "proteina_complexa_shards",
        "tool": "proteina_complexa",
        "foreach": "${params.proteina_complexa_jobs}",
        "max_parallel": 2,
        "inputs": {
          "mode": "protein_binder",
          "target_pdb": "${params.complex_pdb}",
          "target_chain": "A",
          "binder_length": 30,
          "num_designs": 1,
          "search_algorithm": "single-pass",
          "reward_model": "none",
          "steps": ["generate", "filter"],
          "seed": "${item.seed}",
          "run_name": "${item.run_name}"
        },
        "on_failure": "continue"
      },
      {
        "id": "rank_shards",
        "tool": "rank_designs",
        "inputs": {
          "predictions": "${outputs.protenix_shards}",
          "candidates": "${outputs.boltzgen_shards}",
          "top_k": 10,
          "output_prefix": "sharded_gpu_smoke"
        },
        "on_failure": "continue"
      }
    ]
  },
  "success_criteria": {
    "foreach_shards_attempted": true,
    "gpu_ids_recorded_for_gpu_jobs": true,
    "report_html_renders": true
  },
  "warm_tools": [
    "boltz2_affinity",
    "boltzgen",
    "proteina_complexa",
    "protenix_v2"
  ],
  "estimated_llm_calls": 0
}
