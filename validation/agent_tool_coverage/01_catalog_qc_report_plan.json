{
  "mode": "agent_plan",
  "goal": "Coverage run 1: catalog, retrieval, sequence, structure, docking, and reporting-friendly CPU/lightweight tools.",
  "assumptions": [
    "This plan is hand-authored to match the LLM agent plan contract and uses only agent-visible VPA tools.",
    "Independent nodes use on_failure=continue so one unavailable external binary does not hide the rest of the coverage report."
  ],
  "missing_inputs": [],
  "required_tools": [
    "colabdesign_utils",
    "dssp",
    "foldseek",
    "go_sequences",
    "interpro_sequences",
    "ipsae",
    "literature_search",
    "mmseqs2_gpu",
    "prodigy",
    "protein_qc",
    "pxmeter",
    "rank_designs",
    "sequence_analysis",
    "sequence_edit",
    "structure_analysis",
    "template_select",
    "tmalign",
    "vina"
  ],
  "workflow_plan": {
    "name": "agent_coverage_catalog_qc_report",
    "version": "0.1.0",
    "description": "Small end-to-end coverage run for agent-visible retrieval, QC, structural analysis, docking, and report rendering tools.",
    "params": {
      "sequence": {"type": "str", "required": true},
      "query_fasta": {"type": "path", "required": true},
      "template_db_fasta": {"type": "path", "required": true},
      "template_metadata": {"type": "path", "required": true},
      "fixture_pdb_a": {"type": "path", "required": true},
      "fixture_pdb_b": {"type": "path", "required": true},
      "complex_pdb": {"type": "path", "required": true},
      "ipsae_pdb": {"type": "path", "required": true},
      "ipsae_pae": {"type": "path", "required": true},
      "fixture_cif": {"type": "path", "required": true},
      "vina_receptor": {"type": "path", "required": true},
      "vina_ligand": {"type": "path", "required": true}
    },
    "nodes": [
      {
        "id": "literature_search",
        "tool": "literature_search",
        "inputs": {
          "query": "de novo protein binder design pLDDT ipTM",
          "must_include": ["protein"],
          "max_results": 3,
          "result_type": "lite",
          "include_abstracts": false,
          "timeout_s": 20
        },
        "on_failure": "continue"
      },
      {
        "id": "go_sequences",
        "tool": "go_sequences",
        "inputs": {
          "go_id": "GO:0005515",
          "aspect": "mf",
          "max_sequences": 3,
          "reviewed": true,
          "taxon_id": 9606,
          "page_size": 3,
          "max_scan_accessions": 30,
          "timeout_s": 20
        },
        "on_failure": "continue"
      },
      {
        "id": "interpro_sequences",
        "tool": "interpro_sequences",
        "inputs": {
          "interpro_id": "IPR000719",
          "max_sequences": 3,
          "reviewed": true,
          "taxon_id": 9606,
          "page_size": 3,
          "max_scan_accessions": 30,
          "timeout_s": 20
        },
        "on_failure": "continue"
      },
      {
        "id": "sequence_analysis",
        "tool": "sequence_analysis",
        "inputs": {
          "sequence": "${params.sequence}",
          "positions": [1, 5, 10],
          "include_regions": true,
          "include_residue_table": true,
          "output_prefix": "coverage_sequence_analysis"
        },
        "on_failure": "continue"
      },
      {
        "id": "sequence_edit",
        "tool": "sequence_edit",
        "inputs": {
          "operation": "mutate_residues",
          "sequence": "${params.sequence}",
          "mutation_notation": ["F5A"],
          "output_name": "coverage_mutant"
        },
        "on_failure": "continue"
      },
      {
        "id": "protein_qc",
        "tool": "protein_qc",
        "inputs": {
          "sequence": "${params.sequence}",
          "metrics": ["gravy", "instability_index", "pi", "polybasic"]
        },
        "on_failure": "continue"
      },
      {
        "id": "template_select",
        "tool": "template_select",
        "inputs": {
          "query_sequence": "${params.sequence}",
          "template_db": "${params.template_db_fasta}",
          "template_db_kind": "fasta",
          "metadata_table": "${params.template_metadata}",
          "max_templates": 2,
          "min_identity": 0.1,
          "min_coverage": 0.1
        },
        "on_failure": "continue"
      },
      {
        "id": "mmseqs2_gpu",
        "tool": "mmseqs2_gpu",
        "inputs": {
          "query_fasta": "${params.query_fasta}",
          "target_db": "${params.template_db_fasta}",
          "min_seq_id": 0.1,
          "coverage": 0.1,
          "sensitivity": 1.0,
          "max_seqs": 5
        },
        "on_failure": "continue"
      },
      {
        "id": "foldseek",
        "tool": "foldseek",
        "inputs": {
          "query_pdb": "${params.fixture_pdb_a}",
          "target_db": "${params.fixture_pdb_b}",
          "mode": "easy-search",
          "e_value": 10.0,
          "max_seqs": 5
        },
        "on_failure": "continue"
      },
      {
        "id": "tmalign",
        "tool": "tmalign",
        "inputs": {
          "pdb_a": "${params.fixture_pdb_a}",
          "pdb_b": "${params.fixture_pdb_b}",
          "normalize_by": "shorter"
        },
        "on_failure": "continue"
      },
      {
        "id": "dssp",
        "tool": "dssp",
        "inputs": {
          "pdb_path": "${params.fixture_pdb_a}",
          "format": "json"
        },
        "on_failure": "continue"
      },
      {
        "id": "structure_analysis",
        "tool": "structure_analysis",
        "inputs": {
          "structure_path": "${params.complex_pdb}",
          "chain_id": "A",
          "interface_chain_ids": ["B"],
          "positions": [1, 5, 10],
          "run_dssp": false,
          "output_prefix": "coverage_structure_analysis"
        },
        "on_failure": "continue"
      },
      {
        "id": "prodigy",
        "tool": "prodigy",
        "inputs": {
          "pdb_path": "${params.complex_pdb}",
          "chain_a": "A",
          "chain_b": "B"
        },
        "on_failure": "continue"
      },
      {
        "id": "ipsae",
        "tool": "ipsae",
        "inputs": {
          "pae_path": "${params.ipsae_pae}",
          "pdb_path": "${params.ipsae_pdb}",
          "chain_a": "A",
          "chain_b": "B",
          "cutoff": 10.0,
          "dist_cutoff": 10.0
        },
        "on_failure": "continue"
      },
      {
        "id": "vina",
        "tool": "vina",
        "inputs": {
          "receptor_pdbqt": "${params.vina_receptor}",
          "ligand_pdbqt": "${params.vina_ligand}",
          "center": [0.0, 0.0, 0.0],
          "box_size": [20.0, 20.0, 20.0],
          "exhaustiveness": 1,
          "num_modes": 1,
          "seed": 7
        },
        "on_failure": "continue"
      },
      {
        "id": "pxmeter",
        "tool": "pxmeter",
        "inputs": {
          "predicted_cif": "${params.fixture_cif}",
          "reference_cif": "${params.fixture_cif}",
          "metrics": ["lddt"]
        },
        "on_failure": "continue"
      },
      {
        "id": "colabdesign_utils",
        "tool": "colabdesign_utils",
        "inputs": {
          "action": "capabilities",
          "check_import": true
        },
        "on_failure": "continue"
      },
      {
        "id": "rank_designs",
        "tool": "rank_designs",
        "inputs": {
          "predictions": [
            {
              "name": "static_candidate",
              "ranking_score": 0.75,
              "plddt": 82.0,
              "iptm": 0.65,
              "ptm": 0.7,
              "predicted_pdb": "${params.fixture_pdb_a}"
            }
          ],
          "qc_results": [
            {
              "metrics": {"plddt": 82.0},
              "flags": []
            }
          ],
          "candidates": [
            {
              "candidate_id": "static_candidate",
              "pdb_path": "${params.fixture_pdb_a}"
            }
          ],
          "top_k": 1,
          "output_prefix": "coverage_rankings"
        },
        "on_failure": "continue"
      }
    ]
  },
  "success_criteria": {
    "report_html_renders": true,
    "all_independent_nodes_attempted": true
  },
  "warm_tools": [
    "colabdesign_utils",
    "dssp",
    "foldseek",
    "go_sequences",
    "interpro_sequences",
    "ipsae",
    "literature_search",
    "mmseqs2_gpu",
    "prodigy",
    "protein_qc",
    "pxmeter",
    "rank_designs",
    "sequence_analysis",
    "sequence_edit",
    "structure_analysis",
    "template_select",
    "tmalign",
    "vina"
  ],
  "estimated_llm_calls": 0
}
