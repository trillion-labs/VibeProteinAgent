{
  "mode": "agent_plan",
  "goal": "Coverage run 2: first-class design and redesign engines with tiny GPU smoke settings.",
  "assumptions": [
    "This plan intentionally uses small design counts and short diffusion schedules to make broad GPU coverage practical.",
    "Independent nodes use on_failure=continue so every selected engine is attempted and represented in the workflow report."
  ],
  "missing_inputs": [],
  "required_tools": [
    "bindcraft",
    "esm2",
    "esm3",
    "ligandmpnn",
    "proteinmpnn",
    "pxdesign",
    "pyrosetta",
    "rfdiffusion",
    "rfdiffusion3",
    "rfpeptides"
  ],
  "workflow_plan": {
    "name": "agent_coverage_design_engines",
    "version": "0.1.0",
    "description": "Tiny smoke run for agent-visible generative and redesign engines.",
    "params": {
      "short_sequence": {"type": "str", "required": true},
      "fixture_pdb_a": {"type": "path", "required": true},
      "complex_pdb": {"type": "path", "required": true}
    },
    "nodes": [
      {
        "id": "esm2_embedding",
        "tool": "esm2",
        "inputs": {
          "sequence": "${params.short_sequence}",
          "mode": "embedding",
          "model_name": "facebook/esm2_t12_35M_UR50D",
          "return_attention": false
        },
        "on_failure": "continue"
      },
      {
        "id": "esm3_tiny",
        "tool": "esm3",
        "inputs": {
          "sequence": "${params.short_sequence}",
          "model_name": "esm3_sm_open_v1",
          "tracks": ["sequence"],
          "num_steps": 2,
          "temperature": 0.5
        },
        "on_failure": "continue"
      },
      {
        "id": "rfdiffusion_unconditional",
        "tool": "rfdiffusion",
        "inputs": {
          "mode": "unconditional",
          "length_min": 20,
          "length_max": 20,
          "num_designs": 1,
          "num_diffusion_steps": 15,
          "seed": 11
        },
        "on_failure": "continue"
      },
      {
        "id": "rfpeptides_macrocycle",
        "tool": "rfpeptides",
        "inputs": {
          "peptide_length": 8,
          "num_designs": 1,
          "num_diffusion_steps": 15,
          "seed": 7
        },
        "on_failure": "continue"
      },
      {
        "id": "proteinmpnn_redesign",
        "tool": "proteinmpnn",
        "inputs": {
          "pdb_path": "${params.fixture_pdb_a}",
          "chains": ["A"],
          "num_designs": 2,
          "temperature": 0.1,
          "seed": 17
        },
        "on_failure": "continue"
      },
      {
        "id": "ligandmpnn_redesign",
        "tool": "ligandmpnn",
        "inputs": {
          "pdb_path": "${params.fixture_pdb_a}",
            "chains": ["A"],
            "num_designs": 2,
            "temperature": 0.1,
            "model_type": "ligand_mpnn",
            "seed": 19
          },
        "on_failure": "continue"
      },
      {
        "id": "pyrosetta_score",
        "tool": "pyrosetta",
        "inputs": {
          "pdb_path": "${params.fixture_pdb_a}",
          "mode": "score",
          "score_fn": "ref2015",
          "seed": 23
        },
        "on_failure": "continue"
      },
      {
        "id": "pxdesign_infer",
        "tool": "pxdesign",
        "inputs": {
          "target_pdb": "${params.complex_pdb}",
          "target_chain": "A",
          "binder_length": 30,
          "num_samples": 1,
          "num_steps": 20,
          "seed": 29,
          "mode": "infer",
          "preset": "preview"
        },
        "on_failure": "continue"
      },
      {
        "id": "rfdiffusion3_binder",
        "tool": "rfdiffusion3",
        "inputs": {
          "target_pdb": "${params.complex_pdb}",
          "target_chain": "A",
          "target_hotspots": [],
          "binder_length": 30,
          "num_designs": 1,
          "num_diffusion_steps": 10,
          "seed": 31
        },
        "on_failure": "continue"
      },
      {
        "id": "bindcraft_binder",
        "tool": "bindcraft",
        "inputs": {
          "target_pdb": "${params.complex_pdb}",
          "target_chain": "A",
          "target_hotspots": [],
          "binder_length": 30,
          "num_designs": 1,
          "num_recycles": 1,
          "seed": 37,
          "max_trajectories": 1,
          "filter_mode": "permissive"
        },
        "on_failure": "continue"
      }
    ]
  },
  "success_criteria": {
    "report_html_renders": true,
    "gpu_design_nodes_attempted": true
  },
  "warm_tools": [
    "bindcraft",
    "esm2",
    "esm3",
    "ligandmpnn",
    "proteinmpnn",
    "pxdesign",
    "pyrosetta",
    "rfdiffusion",
    "rfdiffusion3",
    "rfpeptides"
  ],
  "estimated_llm_calls": 0
}
